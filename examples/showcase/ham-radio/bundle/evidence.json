  "derivations": [
    {
      "output_path": "domain.entities",
      "decision": "Separate the station, the DXCC entity, the QSO, and the QSL trail so the instrument, the collecting axis, the event, and the confirmation each keep their own lifecycle.",
      "evidence_ids": [
        "ev_ham_adif_fields",
        "ev_ham_identity"
      ],
      "user_decision": null
    },
    {
      "output_path": "domain.entities.qso.fields.rst_sent",
      "decision": "Hold signal reports as text kept verbatim, because a 20m SSB contact exchanges RST 59 while an FT8 contact exchanges -12 dB, and both are real reports.",
      "evidence_ids": [
        "ev_ham_adif_fields"
      ],
      "user_decision": null
    },
    {
      "output_path": "domain.temporal_policy",
      "decision": "Log qso_at in UTC without exception because amateur logs, awards, and ADIF interchange all assume UTC.",
      "evidence_ids": [
        "ev_ham_adif_exchange"
      ],
      "user_decision": "Times are UTC, always"
    },
    {
      "output_path": "experience.views.log",
      "decision": "Anchor the app on the callsign-first entry line rather than the awards map, because capture happens mid-pileup.",
      "evidence_ids": [
        "ev_ham_service"
      ],
      "user_decision": "Entry must keep up with a pileup."
    },
    {
      "output_path": "implementation.exports",
      "decision": "Ship ADIF export beside JSON and CSV because the log must feed LoTW and outlive any one logger.",
      "evidence_ids": [
        "ev_ham_adif_exchange"
      ],
      "user_decision": "ADIF export is non-negotiable"
    },
    {
      "output_path": "domain.indexes.entity_progress",
      "decision": "Index QSOs by entity and time for the worked-versus-confirmed matrix behind the DX Atlas.",
      "evidence_ids": [
        "ev_ham_workloads"
      ],
      "user_decision": null
    },
    {
      "output_path": "experience.visual_world",
      "decision": "Use a dark shack panel with phosphor-amber accents and monospace callsigns instead of dashboard cards or skeuomorphic radio dials.",
      "evidence_ids": [
        "ev_ham_service"
      ],
      "user_decision": "Confirmed means LoTW or a card in hand — eQSL is tracked but does not count"
    }
  ]
}
